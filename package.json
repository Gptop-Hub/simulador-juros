{
  "name": "simulador-juros",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "electron:serve": "wait-on http://localhost:5173 && electron .",
    "dev:electron": "concurrently \"npm run dev:web\" \"npm run electron:serve\"",
    "build:renderer": "vite build",
    "build": "vite build",
    "build:win": "npm run build:renderer && electron-builder --windows nsis",
    "publish:win": "npm run build:renderer && electron-builder --windows --publish always",
    "dist": "npm run build:win",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "description": "Calculadora desktop de juros compostos para empréstimos atrasados",
  "author": "Vítor Moura",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gptop-Hub/simulador-juros.git"
  },
  "build": {
    "appId": "com.vitormoura.simuladorjuros",
    "productName": "Simulador de Juros Compostos",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Gptop-Hub",
        "repo": "simulador-juros",
        "releaseType": "release"
      }
    ]
  }
}
